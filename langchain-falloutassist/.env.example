DATABASE_BACKEND=postgres
DATABASE_URL=postgresql://falloutassist:change-me@localhost:5432/falloutassist
SESSION_SECRET=
# Canonical public origin for production Rovo OAuth, e.g. https://falloutassist.example.com.
# Leave blank for local HTTP/localhost-tunnel use; set after HTTPS DNS and TLS are ready.
ROVO_PUBLIC_BASE_URL=
# true forces Secure cookies, false disables them for local HTTP, blank auto-enables
# them when ROVO_PUBLIC_BASE_URL is HTTPS.
SESSION_COOKIE_SECURE=

# Redis 8+ with vector search; optional until enabled/configured in Connections.
# This URL may contain credentials and is masked/encrypted when saved in the UI.
SEMANTIC_CACHE_REDIS_URL=
SEMANTIC_CACHE_NAMESPACE=falloutassist

# Jira, Rovo, Azure OpenAI, Langfuse, retrieval, and publishing are configured
# by an administrator in the dashboard. Existing .env values remain as fallback
# until the corresponding field is saved in the UI.

# Optional service-to-service key for the downstream knowledge-routing agent.
# Use a unique random value of at least 32 characters.
KNOWLEDGE_ROUTER_API_KEY=

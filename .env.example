# Copy to .env and fill in values
JIRA_EMAIL=
JIRA_API_TOKEN=

# LLM provider keys — all free tier, no card. Fill in whichever you use.
GROQ_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=

# Synapt — Azure OpenAI generation provider (provider: "synapt" in config.json).
# Auth is an api-key header; the URL embeds the deployment + api-version.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-05-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini

# Secret used to sign the 👍/👎 feedback links posted in Jira comments. Set any
# long random string. If left blank, a stable key is derived from JIRA_API_TOKEN.
FEEDBACK_SECRET=

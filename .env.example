# Copy to .env and fill in values
JIRA_EMAIL=
JIRA_API_TOKEN=

# LLM provider keys — all free tier, no card. Fill in whichever you use.
GROQ_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=

# Secret used to sign the 👍/👎 feedback links posted in Jira comments. Set any
# long random string. If left blank, a stable key is derived from JIRA_API_TOKEN.
FEEDBACK_SECRET=
